<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bg_dark"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TITLE -->
        <TextView
            android:text="📝 Create Quiz"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/quizTitle"
            android:hint="Enter Quiz Title"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/input_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- TIMER -->
        <EditText
            android:id="@+id/quizTimer"
            android:hint="Enter Quiz Time (minutes)"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/input_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <!-- QUESTIONS CONTAINER -->
        <LinearLayout
            android:id="@+id/questionContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ADD QUESTION -->
        <Button
            android:id="@+id/addQuestionBtn"
            android:text="➕ Add Question"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/card_dark"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- SHUFFLE -->
        <Button
            android:id="@+id/shuffleAllBtn"
            android:text="🔀 Shuffle Questions"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/card_dark"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- SAVE -->
        <Button
            android:id="@+id/saveQuiz"
            android:text="💾 Save Quiz"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/accent"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- PROGRESS -->
        <ProgressBar
            android:id="@+id/quizProgress"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/statusText"
            android:text="Saving..."
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>